<?xml version="1.0" encoding="utf-8"?>
<!-- Key number 3: arrival SOC vs reserve (wide tile: label + number on the left, visual + note on the right, fits ~250dp height) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tileArrival"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/tile_pad"
    android:paddingTop="28dp"
    android:paddingEnd="@dimen/tile_pad"
    android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_s"
                    android:layout_height="@dimen/icon_s"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_flag"
                    android:tint="@color/sg_text_2" />

                <TextView
                    style="@style/T.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:singleLine="true"
                    android:id="@+id/arrivalLabel"
                    android:text="@string/label_arrival"
                    android:textColor="@color/sg_text_2"
                    android:textSize="30sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/arrivalText"
                    style="@style/T.Feature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="--%"
                    android:textSize="@dimen/t_feature" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="32dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <ai.staygo.ui.SocBar
                android:id="@+id/arrivalBar"
                android:layout_width="match_parent"
                android:layout_height="28dp" />

            <TextView
                android:id="@+id/arrivalNote"
                style="@style/T.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text=" " />
        </LinearLayout>
</LinearLayout>
