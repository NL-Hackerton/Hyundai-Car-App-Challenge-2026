<?xml version="1.0" encoding="utf-8"?>
<!-- Page navigation bar (container height 80dp): app icon, title (wide windows only), charging status chip,
     destination chip, settings button. The settings button keeps its place in every window; the destination
     chip is the element that shrinks. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/topbar"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@null"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/topTitle"
        style="@style/T.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:singleLine="true"
        android:text="@string/app_title"
        android:textSize="40sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="32dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_dot" />

        <TextView
            android:id="@+id/statusText"
            style="@style/T.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:singleLine="true"
            android:text=" "
            android:textSize="30sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/destChip"
        style="@style/T.Label"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_chip_outline"
        android:drawableStart="@drawable/ic_place"
        android:drawablePadding="12dp"
        android:drawableTint="@color/sg_text_2"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxWidth="@dimen/dest_max"
        android:paddingStart="24dp"
        android:paddingEnd="32dp"
        android:singleLine="true"
        android:text=" "
        android:textSize="30sp" />

    <ImageView
        android:id="@+id/infoButton"
        android:layout_width="@dimen/step_size"
        android:layout_height="@dimen/step_size"
        android:layout_marginStart="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/info_open"
        android:focusable="true"
        android:padding="16dp"
        android:src="@drawable/ic_info"
        android:tint="@color/sg_text_2" />
</LinearLayout>
