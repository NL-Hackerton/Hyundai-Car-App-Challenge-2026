<?xml version="1.0" encoding="utf-8"?>
<!-- Hero: one verdict, one headline, one reason line (glance in 1-2 s), status chip and the navi route line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heroCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="@dimen/hero_pad">

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.6" />

    <TextView
        android:id="@+id/verdictPill"
        style="@style/T.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip"
        android:paddingStart="40dp"
        android:paddingTop="14dp"
        android:paddingEnd="44dp"
        android:paddingBottom="14dp"
        android:text="대기"
        android:textFontWeight="800"
        android:textSize="@dimen/t_verdict" />

    <TextView
        android:id="@+id/headlineText"
        style="@style/T.Headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hero_gap"
        android:ellipsize="end"
        android:maxLines="2"
        android:text=" " />

    <TextView
        android:id="@+id/reasonText"
        style="@style/T.BodyL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text=" " />

    <TextView
        android:id="@+id/heroChip"
        style="@style/T.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_chip"
        android:paddingStart="28dp"
        android:paddingTop="12dp"
        android:paddingEnd="28dp"
        android:paddingBottom="12dp"
        android:text=" "
        android:textSize="30sp"
        android:visibility="gone" />

    <!-- The one action of a blocked state (permission settings, confirm charging). -->
    <TextView
        android:id="@+id/heroAction"
        style="@style/T.Label"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/step_size"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_chip_outline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="@dimen/btn_pad_h"
        android:paddingEnd="@dimen/btn_pad_h"
        android:text=" "
        android:textColor="@color/sg_go_text"
        android:visibility="gone" />

    <!-- Reserve SOC (or the target SOC while the navigation gives no estimate), 5 %p per tap. -->
    <LinearLayout
        android:id="@+id/stepRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/stepMinus"
            style="@style/T.Title"
            android:layout_width="@dimen/step_size"
            android:layout_height="@dimen/step_size"
            android:background="@drawable/bg_chip_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="−" />

        <TextView
            android:id="@+id/stepLabel"
            style="@style/T.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:singleLine="true"
            android:text=" "
            android:textColor="@color/sg_text_2" />

        <TextView
            android:id="@+id/stepPlus"
            style="@style/T.Title"
            android:layout_width="@dimen/step_size"
            android:layout_height="@dimen/step_size"
            android:background="@drawable/bg_chip_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="+" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/icon_s"
            android:layout_height="@dimen/icon_s"
            android:contentDescription="@null"
            android:src="@drawable/ic_route"
            android:tint="@color/sg_text_3" />

        <TextView
            android:id="@+id/routeText"
            style="@style/T.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text=" "
            android:textSize="30sp" />
    </LinearLayout>
</LinearLayout>
