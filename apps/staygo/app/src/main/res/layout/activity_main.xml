<?xml version="1.0" encoding="utf-8"?>
<!--
  Narrow and portrait windows (Connect-W 1:2 side window, wide window 1040x850, portrait 840x1184):
  hero, three key numbers in one row, the action row, footer. Wide landscape: layout-w1100dp/activity_main.xml.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sg_bg">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="20dp">

        <include layout="@layout/topbar" />

        <include
            layout="@layout/hero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/gap"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                layout="@layout/tile_soc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                layout="@layout/tile_power"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap"
                android:layout_weight="1" />

            <include
                layout="@layout/tile_arrival"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap"
                android:layout_weight="1" />
        </LinearLayout>

        <include
            layout="@layout/actions"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_primary"
            android:layout_marginTop="@dimen/gap" />

        <include
            layout="@layout/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <include layout="@layout/overlays" />
</FrameLayout>
