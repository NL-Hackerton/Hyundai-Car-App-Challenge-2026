<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingTop="28dp"
        android:paddingEnd="44dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:text="차량 신호 연결 중"
                android:textColor="@color/ink_soft"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/destChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip"
                android:paddingStart="36dp"
                android:paddingTop="14dp"
                android:paddingEnd="36dp"
                android:paddingBottom="14dp"
                android:text="목적지 확인 중"
                android:textColor="@color/ink_soft"
                android:textSize="30sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="StayGo"
                android:textColor="@color/blue"
                android:textSize="40sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="32dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="600dp"
                android:layout_height="match_parent"
                android:background="@drawable/card"
                android:orientation="vertical"
                android:paddingStart="48dp"
                android:paddingTop="36dp"
                android:paddingEnd="48dp"
                android:paddingBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="현재 SOC"
                    android:textColor="@color/muted"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/socText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:text="--%"
                    android:textColor="@color/ink"
                    android:textSize="168sp" />

                <ai.staygo.ui.SocBar
                    android:id="@+id/socBar"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/powerText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="충전전력 --"
                        android:textColor="@color/ink"
                        android:textSize="44sp" />

                    <TextView
                        android:id="@+id/powerTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:background="@drawable/chip"
                        android:paddingStart="18dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="4dp"
                        android:text="추정"
                        android:textColor="@color/muted"
                        android:textSize="28sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/powerNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=" "
                    android:textColor="@color/muted"
                    android:textSize="30sp" />

                <ai.staygo.ui.PowerChart
                    android:id="@+id/powerChart"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="20dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="40dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/card"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="지금 출발하면"
                        android:textColor="@color/muted"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/arrivalText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="내비 계산을 기다리는 중"
                        android:textColor="@color/ink"
                        android:textSize="52sp" />

                    <TextView
                        android:id="@+id/arrivalNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text=" "
                        android:textColor="@color/green_text"
                        android:textSize="30sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="32dp"
                    android:layout_weight="1"
                    android:background="@drawable/card"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="내비 경로"
                        android:textColor="@color/muted"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/routeText"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=" "
                        android:textColor="@color/ink"
                        android:textSize="46sp" />

                    <TextView
                        android:id="@+id/routeNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text=" "
                        android:textColor="@color/muted"
                        android:textSize="30sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttons"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/stayButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="56dp"
                android:paddingEnd="56dp">

                <TextView
                    android:id="@+id/stayTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_bold"
                    android:text="Stay · 더 충전"
                    android:textSize="54sp" />

                <TextView
                    android:id="@+id/staySub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text=" "
                    android:textSize="30sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/goButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="40dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="56dp"
                android:paddingEnd="56dp">

                <TextView
                    android:id="@+id/goTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_bold"
                    android:text="Go · 지금 출발"
                    android:textSize="54sp" />

                <TextView
                    android:id="@+id/goSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="목적지 경로를 내비에 전달"
                    android:textSize="30sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/footText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=" "
                android:textColor="@color/muted"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/ruleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" "
                android:textColor="@color/muted"
                android:textSize="28sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/drivingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/night"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_bold"
            android:text="주행 중에는 조작할 수 없습니다"
            android:textColor="#FFFFFF"
            android:textSize="72sp" />

        <TextView
            android:id="@+id/drivingSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text=" "
            android:textColor="#B8C2CE"
            android:textSize="44sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/toast"
        android:paddingStart="64dp"
        android:paddingTop="36dp"
        android:paddingEnd="64dp"
        android:paddingBottom="36dp"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:visibility="gone" />
</FrameLayout>
