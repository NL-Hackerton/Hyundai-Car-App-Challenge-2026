<?xml version="1.0" encoding="utf-8"?>
<!-- Key number 2: charging power, trend and sparkline (stacked tile) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tilePower"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="@dimen/tile_pad">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/tile_label_icon"
            android:layout_height="@dimen/icon_s"
            android:contentDescription="@null"
            android:src="@drawable/ic_bolt"
            android:tint="@color/sg_text_2" />

        <TextView
            style="@style/T.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tile_label_gap"
            android:singleLine="true"
            android:id="@+id/powerLabel"
            android:text="@string/label_power"
            android:textColor="@color/sg_text_2"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/powerTag"
            style="@style/T.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_chip"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp"
            android:text="추정"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="true"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/powerText"
            style="@style/T.Feature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="--"
            android:textSize="@dimen/t_feature" />
        <TextView
            android:id="@+id/powerUnit"
            style="@style/T.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="kW"
            android:textColor="@color/sg_text_2"
            android:textSize="@dimen/t_unit" />
        <TextView
            android:id="@+id/powerTrend"
            style="@style/T.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text=" "
            android:textSize="@dimen/t_unit" />
    </LinearLayout>
    <ai.staygo.ui.PowerChart
        android:id="@+id/powerChart"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spark_h"
        android:layout_marginTop="12dp" />
    <TextView
        android:id="@+id/powerNote"
        style="@style/T.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text=" " />
</LinearLayout>
