<?xml version="1.0" encoding="utf-8"?>
<!--
  Pleos Connect 2.1.5 color tokens (Pleos_Connect_design_assets_215.fig / display_guide_215.fig, Light mode).
  Dark mode values are in values-night/colors.xml. sg_* are StayGo's semantic aliases onto those tokens;
  every text/background pair below is >= 4.5:1 (checked by apps/staygo/tools/check_contrast.py).
-->
<resources>
    <!-- Pleos tokens (name = Figma variable, Android codeSyntax where the kit defines one) -->
    <color name="color_surface_background_primary">#F7F8FA</color>   <!-- background/primary -->
    <color name="color_surface_background_secondary">#FFFFFF</color> <!-- background/secondary -->
    <color name="color_surface_container">#FFFFFF</color>            <!-- surface/basic -->
    <color name="color_surface_container_high">#EDEEF2</color>       <!-- surface/high -->
    <color name="color_surface_accent">#E0E1E6</color>               <!-- surface/accent -->
    <color name="color_label_gray_primary">#131417</color>           <!-- text/dark/primary -->
    <color name="color_label_gray_secondary">#D6131417</color>       <!-- text/dark/secondary -->
    <color name="color_label_gray_tertiary">#A3131417</color>        <!-- text/dark/tertiary -->
    <color name="color_divider_secondary">#1A131417</color>          <!-- divider/secondary -->
    <color name="color_button_basic_enabled">#0D131417</color>       <!-- button/basic/enabled -->
    <color name="color_button_basic_pressed">#1A131417</color>       <!-- button/basic/pressed -->
    <color name="color_informative_positive">#0064FF</color>         <!-- informative/positive = regulation/blue -->
    <color name="color_informative_active">#02C265</color>           <!-- informative/active (charging, switch on) -->
    <color name="color_regulation_orange">#FF8A00</color>            <!-- regulation/orange -->
    <color name="color_basic_800">#1D1E21</color>                    <!-- basic/800 (inverse surface) -->
    <color name="color_basic_00">#FFFFFF</color>                     <!-- basic/00 (on inverse) -->
    <color name="color_static_dark_100">#131417</color>              <!-- static/dark/100 -->
    <color name="color_static_light_100">#FFFFFF</color>             <!-- static/light/100 -->
    <color name="color_overlay_driving">#131417</color>              <!-- static/dark/100 (driving lock) -->

    <!-- StayGo semantic aliases -->
    <color name="sg_bg">@color/color_surface_background_primary</color>
    <color name="sg_card">@color/color_surface_container</color>
    <color name="sg_card_high">@color/color_surface_container_high</color>
    <color name="sg_line">@color/color_divider_secondary</color>
    <color name="sg_text">@color/color_label_gray_primary</color>
    <color name="sg_text_2">@color/color_label_gray_secondary</color>
    <color name="sg_text_3">@color/color_label_gray_tertiary</color>
    <color name="sg_go">#0064FF</color>                 <!-- Go fill: informative/positive (light); kept in dark for white-label contrast -->
    <color name="sg_on_go">@color/color_static_light_100</color>
    <color name="sg_go_text">@color/color_informative_positive</color>
    <color name="sg_stay">@color/color_informative_active</color>
    <color name="sg_on_stay">@color/color_static_dark_100</color>
    <color name="sg_warn">@color/color_regulation_orange</color>
    <color name="sg_on_warn">@color/color_static_dark_100</color>
    <color name="sg_basic">@color/color_button_basic_enabled</color>
    <color name="sg_basic_pressed">@color/color_button_basic_pressed</color>
    <color name="sg_toast">@color/color_basic_800</color>
    <color name="sg_on_toast">@color/color_basic_00</color>
    <color name="sg_track">@color/color_surface_accent</color>
</resources>
